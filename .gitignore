# kernels: keep dir, ignore everything inside
/kernels/*
!/kernels/.gitkeep

# images: keep dir skeletons, ignore contents
/images/*

#profiles keep dir, ignore contents
/profiles/*
!/profiles/.gitkeep

# user & agent: keep dir, ignore everything inside
/user/*
!/user/.gitkeep
!/user/kctf/
/user/kctf/*
!/user/kctf/.gitkeep

/agent/*
!/agent/.gitkeep

# Common large artifacts
*.tar.gz
*.tar.xz
*.zip
*.img
*.iso

# Docker user-specific env
.env

# Generic build/cache outputs anywhere
**/build/**
**/out/**
**/tmp/**
**/.cache/**


# SKILL-SIF
/SKILL-SIF/inbox/*
!/SKILL-SIF/inbox/.gitkeep
