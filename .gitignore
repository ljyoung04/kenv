# kernels: keep dir, ignore everything inside
/kernels/*
!/kernels/.gitkeep

# images: keep dir skeletons, ignore contents
/images/*
!/images/arm64/
!/images/x86/
/images/arm64/*
!/images/arm64/.gitkeep
/images/x86/*
!/images/x86/.gitkeep

# share: keep dir, ignore everything inside
/share/*
!/share/.gitkeep

# androids workspace: keep dir skeleton only
/androids/*
!/androids/.gitkeep

# Common large artifacts
*.tar.gz
*.tar.xz
*.zip
*.img
*.iso

# Generic build/cache outputs anywhere
**/build/**
**/out/**
**/tmp/**
**/.cache/**
