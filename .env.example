# Auto-generated by init.sh — run `./init.sh` to create .env
#
# Or copy this file manually and adjust:
#   cp .env.example .env

# Host user UID/GID (init.sh detects automatically via id -u / id -g)
HOST_UID=1000
HOST_GID=1000

# SSH port forwarded to host (container:22 -> host:SSH_PORT)
# init.sh picks an available port in 2000-3000
SSH_PORT=2222
